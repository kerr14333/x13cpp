# Build outputs
build/
*.o
*.obj
*.exe
*.dll
*.so
*.dylib
*.a
*.lib

# Oracle build artifacts (source stays tracked)
oracle/fortran/*.o
oracle/build-*/

# Golden outputs are LFS-tracked; scratch runs are not
tests/parity/_runs/
tests/compare/_reports/

# Harness/oracle run-output accidentally written into the corpus tree: keep only
# the source specs/data/docs, ignore every generated save-table (.a1/.s10/.fct/...).
tests/corpus/**/*.*
!tests/corpus/**/*.spc
!tests/corpus/**/*.dat
!tests/corpus/**/*.md
!tests/corpus/**/*.py
!tests/corpus/**/*.mta

# Python
__pycache__/
*.pyc
*.egg-info/
dist/
wheelhouse/
.pytest_cache/

# R
r-pkg/*.Rcheck/
r-pkg/*.tar.gz
*.Rproj.user/
.RData
.Rhistory

# Editors/OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Claude Code local settings
.claude/settings.local.json

# Stray root CTest artifacts (ctest run from repo root)
/Testing/
build-cov/
coverage/

# Private research notes (CB-4 lagind OOB analysis, etc.) -- not for the repo
/research/
tools/_sweep/
