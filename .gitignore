*.pyc
*.egg-info/
dist/
wheelhouse/
.pytest_cache/

# R
r-pkg/*.Rcheck/
r-pkg/*.tar.gz
*.Rproj.user/
.RData
.Rhistory

# Editors/OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Claude Code local settings
.claude/settings.local.json

# Stray root CTest artifacts (ctest run from repo root)
/Testing/
