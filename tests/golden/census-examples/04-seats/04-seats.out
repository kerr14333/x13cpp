     Contents of spc file 04-seats.spc

 Line #
 ------
      1: # Census X-13ARIMA-SEATS manual â€” SEATS (ARIMA model-based) example.
      2: # Log transform, airline model, then SEATS seasonal adjustment.
      3: # NOTE: seats{} and x11{} are mutually exclusive â€” a spec may contain one
      4: # or the other, never both.
      5: series{
      6:   title  = "International Airline Passengers"
      7:   file   = "airline.dat"
      8:   start  = 1949.01
      9:   period = 12
     10: }
     11: transform{
     12:   function = log
     13: }
     14: regression{
     15:   variables = (td easter[8])
     16: }
     17: arima{
     18:   model = (0 1 1)(0 1 1)
     19: }
     20: estimate{ }
     21: forecast{
     22:   maxlead = 12
     23: }
     24: seats{ }
