     Contents of spc file 03-automdl.spc

 Line #
 ------
      1: # Census X-13ARIMA-SEATS manual — automatic model identification example.
      2: # Automatic transform selection and automatic ARIMA model identification
      3: # (the TRAMO-style automdl procedure), then X-11 seasonal adjustment.
      4: series{
      5:   title  = "International Airline Passengers"
      6:   file   = "airline.dat"
      7:   start  = 1949.01
      8:   period = 12
      9: }
     10: transform{
     11:   function = auto
     12: }
     13: regression{
     14:   aictest = (td easter)
     15: }
     16: automdl{ }
     17: forecast{
     18:   maxlead = 24
     19: }
     20: x11{ }


