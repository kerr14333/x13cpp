      1: # Census X-13ARIMA-SEATS manual — "Getting Started" example.
      2: # Basic X-11 seasonal adjustment of the airline series, all defaults.
      3: #
      4: # Run from this directory so the relative data path resolves:
      5: #   x13as -i 01-basic-x11 -o 01-basic-x11.out
      6: series{
      7:   title  = "International Airline Passengers"
      8:   file   = "airline.dat"
      9:   start  = 1949.01
     10:   period = 12
     11: }
     12: x11{ }
