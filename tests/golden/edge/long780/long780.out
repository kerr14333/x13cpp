     Contents of spc file long780.spc

 Line #
 ------
      1: # EDGE CASE: series at exactly the program's maximum monthly length.
      2: # POBS = PYR1 * PSP = 65 * 12 = 780 (oracle/fortran/srslen.prm). This series
      3: # has exactly 780 monthly observations (1950.01 - 2014.12), sitting right at the
      4: # limit. Parity must hold at the boundary.
      5: series{
      6:   title  = "Synthetic monthly series at the 780-observation limit"
      7:   file   = "long780.dat"
      8:   start  = 1950.01
      9:   period = 12
     10: }
     11: transform{
     12:   function = auto
     13: }
     14: automdl{ }
     15: x11{ }


