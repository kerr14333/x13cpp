# Hand-authored (2026-08-11). The ACCEPT half of regression{aictest=(user)}.
#
# Same spec as airline_reg-aictest-user with aicdiff pushed to -100, so
# usraic.f:196's `Dfaicu.gt.Rgaicd(PUAIC)` goes true on a diff of -3.42 and
# the test takes its RESTORE branch: /usrreg/ is copied back from the local
# backup, every user column is re-added by adrgef with the group title its
# saved Usrtyp selects, and the model is refitted. Without this spec only
# usraic's reject path is gated, and the whole backup/restore half -- which
# is two thirds of the routine -- is dead code in the suite.
#
# Oracle: nreg 2, and identical AICCs to the reject sibling (the test itself
# does not change, only the verdict).
#
# NOT produced by gen*.py.
series{
  title  = "Intl Airline Passengers"
  file   = "../data/airline.dat"
  start  = 1949.01
  period = 12
  save   = (b1)
}
transform{
  function = log
}
regression{
