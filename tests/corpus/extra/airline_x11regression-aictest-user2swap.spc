# Hand-authored (NOT produced by genextra.py).
# The MIRROR of -aictest-user2: identical but for the declared usertype= order,
# u1 = td and u2 = user. Together the pair is the measurement behind CB-36.
#
# This is the spec that reaches CB-36: editor.f:1710 reads a STALE local to
# decide whether the irregular regression has a holiday group, and u1's
# `usertype=td` makes it declare u2 the holiday group. Holgrp>0 then
# disqualifies the 2.5-sigma clip, so the whole run switches to automatic AO
# outlier identification -- seven AO regressors the -user2 spelling does not
# get, and every row of b16/c16/d10/d11 different between the two.
#
# It also pins x11mdl.f:531-540: a column whose Rgvrtp is the generic PRGTUD
# takes its EFFECTIVE x11ref type from the declared usertype= list, so u2 lands
# in the TRADING-DAY factor here. Without that remap b16 comes out short by
# b_u2*u2/Xnstar (7.6e-4 relative), at OUTCOME: OK.
series{
  title = "International Airline Passengers"
  file = "../data/airline.dat"
  start = 1949.01
  period = 12
}
transform{
  function = log
}
arima{
  model = (0 1 1)(0 1 1)
}
estimate{
  print = all
  savelog = all
}
x11{
  print = all
  save = (d10 d11 d12 d13 d16)
  savelog = all
}
x11regression{
